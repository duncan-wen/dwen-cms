{
  "name": "dwen-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "bash scripts/build-check.sh",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/content-check.ts",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "smoke": "SITE_URL=https://dwen.example CONTENT_DIR=e2e/content pnpm build && pnpm test:smoke",
    "shots": "tsx scripts/shots.ts",
    "promo": "tsx scripts/promo.ts",
    "cover": "tsx scripts/cover.ts",
    "linkedin": "tsx scripts/linkedin.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm content:check && pnpm content:check e2e/content && pnpm test",
    "prepare": "simple-git-hooks",
    "deck": "tsx scripts/deck.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@remotion/player": "4.0.541",
    "@shikijs/rehype": "^4.5.0",
    "@vercel/analytics": "^2.0.1",
    "beautiful-mermaid": "1.1.3",
    "botid": "^1.5.12",
    "feed": "6.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.4",
    "js-yaml": "^5.5.0",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.541",
    "resend": "^6.37.0",
    "shiki": "^4.5.0",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/subset-font": "^2.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
